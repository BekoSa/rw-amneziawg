{
  "additionalProperties": false,
  "properties": {
    "envelope_id": {
      "format": "uuid",
      "title": "Envelope Id",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    },
    "backend_ipv4": {
      "title": "Backend Ipv4",
      "type": "string"
    },
    "bind_addresses": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Bind Addresses",
      "type": "array"
    },
    "reserved_ports": {
      "items": {
        "maximum": 65535,
