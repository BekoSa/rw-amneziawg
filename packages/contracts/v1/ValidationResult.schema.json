{
  "$defs": {
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "valid",
    "revision",
    "digest"
  ],
  "title": "ValidationResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
