      "minimum": 1,
      "title": "Max Bindings",
      "type": "integer"
    },
    "max_udp_flows": {
      "default": 4096,
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Udp Flows",
      "type": "integer"
    },
    "max_tcp_connections": {
      "default": 4096,
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Tcp Connections",
      "type": "integer"
    }
  },
  "required": [
    "envelope_id",
    "node_id",
    "backend_ipv4"
  ],
  "title": "NodeInstallEnvelope",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
