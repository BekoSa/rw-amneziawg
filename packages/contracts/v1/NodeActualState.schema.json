{
  "$defs": {
    "DeploymentState": {
      "enum": [
        "DRAFT",
        "VALIDATED",
        "APPLYING",
        "READY",
        "ROLLING_BACK",
        "DEGRADED",
        "ERROR"
      ],
      "title": "DeploymentState",
      "type": "string"
    },
    "IngressBinding": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "format": "uuid",
          "title": "Binding Id",
          "type": "string"
        },
        "deployment_id": {
          "format": "uuid",
          "title": "Deployment Id",
          "type": "string"
        },
        "transport": {
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Transport",
          "type": "string"
        },
        "public_address": {
          "default": "0.0.0.0",
          "title": "Public Address",
          "type": "string"
        },
        "public_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Public Port",
          "type": "integer"
        },
        "backend_role": {
          "enum": [
            "awg",
            "trusttunnel",
            "acme-http",
            "acme-tls-alpn"
          ],
          "title": "Backend Role",
          "type": "string"
        },
        "backend_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Backend Port",
          "type": "integer"
        }
      },
      "required": [
        "binding_id",
        "deployment_id",
        "transport",
        "public_port",
        "backend_role",
        "backend_port"
      ],
      "title": "IngressBinding",
      "type": "object"
    },
    "NodeBindingActual": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/IngressBinding"
        },
        "state": {
          "enum": [
            "PREPARED",
            "ACTIVE",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        },
        "backend_ready": {
          "default": false,
          "title": "Backend Ready",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidationIssue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "binding",
        "state"
      ],
      "title": "NodeBindingActual",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "node.remnawave-extension.io/v1",
      "default": "node.remnawave-extension.io/v1",
      "title": "Api Version",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    },
    "desired_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Desired Revision"
    },
    "accepted_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Revision"
    },
    "applied_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied Revision"
    },
    "last_known_good_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Known Good Revision"
    },
    "applied_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied Digest"
    },
    "state": {
      "$ref": "#/$defs/DeploymentState",
      "default": "DRAFT"
    },
    "healthy": {
      "default": false,
      "title": "Healthy",
      "type": "boolean"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/NodeBindingActual"
      },
      "maxItems": 1024,
      "title": "Bindings",
      "type": "array"
    },
    "runtime_epoch": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Epoch"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationIssue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "node_id"
  ],
  "title": "NodeActualState",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
