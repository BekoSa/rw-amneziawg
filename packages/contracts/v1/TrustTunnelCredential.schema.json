{
  "additionalProperties": false,
  "properties": {
    "peer_id": {
      "format": "uuid",
      "title": "Peer Id",
      "type": "string"
    },
    "user_uuid": {
      "format": "uuid",
      "title": "User Uuid",
      "type": "string"
    },
    "username": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Username",
      "type": "string"
    },
    "password": {
      "format": "password",
      "maxLength": 1024,
      "minLength": 32,
      "title": "Password",
      "type": "string",
      "writeOnly": true
    },
    "credential_generation": {
      "default": 1,
      "minimum": 1,
      "title": "Credential Generation",
      "type": "integer"
    }
  },
  "required": [
    "peer_id",
    "user_uuid",
    "username",
    "password"
  ],
  "title": "TrustTunnelCredential",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
