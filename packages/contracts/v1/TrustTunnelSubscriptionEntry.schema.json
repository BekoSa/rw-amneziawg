{
  "$defs": {
    "TrustTunnelEndpoint": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 443,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "TrustTunnelEndpoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "format": "uuid",
      "title": "Profile Id",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    },
    "peer_id": {
      "format": "uuid",
      "title": "Peer Id",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "endpoint": {
      "$ref": "#/$defs/TrustTunnelEndpoint"
    },
    "tls_server_name": {
      "maxLength": 253,
      "minLength": 1,
      "title": "Tls Server Name",
      "type": "string"
    },
    "username": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Username",
      "type": "string"
    },
    "password": {
      "format": "password",
      "maxLength": 1024,
      "minLength": 32,
      "title": "Password",
      "type": "string",
      "writeOnly": true
    },
    "credential_generation": {
      "default": 1,
      "minimum": 1,
      "title": "Credential Generation",
      "type": "integer"
    },
    "native_deeplink": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Deeplink"
    },
    "native_toml": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Toml"
    }
  },
  "required": [
    "profile_id",
    "node_id",
    "peer_id",
    "name",
    "endpoint",
    "tls_server_name",
    "username",
    "password"
  ],
  "title": "TrustTunnelSubscriptionEntry",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
